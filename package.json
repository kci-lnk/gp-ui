{
  "name": "@kci-lnk/gp-ui",
  "version": "0.1.5",
  "type": "module",
  "description": "Vue 3 components with CSS variable themes, accessible primitives and glass navigation",
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/gp-ui.js"
    },
    "./style.css": "./dist/style.css"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build",
    "test": "playwright test",
    "build:demo": "node scripts/build.mjs --demo",
    "verify:package": "node scripts/verify-package.mjs",
    "check": "npm run typecheck && npm test && npm run build:demo && npm run verify:package"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@types/web-bluetooth": "0.0.21",
    "reka-ui": "2.11.0",
    "vue-component-type-helpers": "3.3.13"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vue": "3.5.43",
    "vue-tsc": "3.3.13"
  },
  "license": "MIT",
  "author": "kci-lnk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kci-lnk/gp-ui.git"
  },
  "homepage": "https://github.com/kci-lnk/gp-ui#readme",
  "bugs": {
    "url": "https://github.com/kci-lnk/gp-ui/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "typescript",
    "components",
    "ui",
    "css-variables",
    "reka-ui"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
